<Window x:Class="NLoggerLib.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NLogger" Height="520" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Log file location bar -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Log File Location:" Foreground="#DDDDDD"
                       VerticalAlignment="Center" Margin="2,0,8,0"/>
            <TextBox Grid.Column="1" x:Name="LocationBox" VerticalContentAlignment="Center"
                     Padding="4,3" Background="#2D2D30" Foreground="#EEEEEE"
                     BorderBrush="#3F3F46"
                     ToolTip="Root path. A dated YYYY-MMDD folder is created here for each day's log."/>
            <Button Grid.Column="2" x:Name="BrowseButton" Content="Browse…" Click="BrowseButton_Click"/>
            <Button Grid.Column="3" x:Name="OpenFolderButton" Content="Open" Click="OpenFolderButton_Click"
                    ToolTip="Open today's dated log folder in Explorer"/>
        </Grid>

        <!-- Message area -->
        <TextBox Grid.Row="1" x:Name="MessageBox"
                 IsReadOnly="True" IsReadOnlyCaretVisible="True"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="13"
                 Background="#252526" Foreground="#D4D4D4" BorderBrush="#3F3F46"
                 Padding="6"/>

        <!-- Bottom toolbar -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" x:Name="AutoScrollBox" Content="Auto-scroll"
                      IsChecked="True" Foreground="#DDDDDD" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CopyButton" Content="Copy All" Click="CopyButton_Click"/>
                <Button x:Name="CopySelButton" Content="Copy Selection" Click="CopySelButton_Click"/>
                <Button x:Name="SaveButton" Content="Save to File" Click="SaveButton_Click"/>
                <Button x:Name="ClearButton" Content="Clear" Click="ClearButton_Click"/>
                <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
